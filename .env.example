# Export the settings you need in your shell before launching DocQA.
DOCQA_CORPUS=data/corpus
DOCQA_MODE=hybrid
DOCQA_CHUNK_SIZE=200
DOCQA_OVERLAP=35
DOCQA_THRESHOLD=0.5
DOCQA_PROVIDER=offline

# Optional OpenAI-compatible provider. Include the API prefix (usually /v1).
# A local Ollama endpoint defaults to http://localhost:11434/v1.
DOCQA_BASE_URL=
DOCQA_MODEL=
DOCQA_API_KEY=

# Optional FastEmbed cache settings.
DOCQA_MODEL_CACHE=
DOCQA_LOCAL_FILES_ONLY=0
